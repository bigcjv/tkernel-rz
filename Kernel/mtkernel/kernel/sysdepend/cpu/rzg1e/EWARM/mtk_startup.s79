; AP-RZG-0A RZ/G1E CPU0 reset and exception vector setup for IAR.

        REQUIRE8
        PRESERVE8

SYS_MODE        EQU     0x1F
SVC_MODE        EQU     0x13
IRQ_MODE        EQU     0x12
FIQ_MODE        EQU     0x11
ABT_MODE        EQU     0x17
UND_MODE        EQU     0x1B

RWDT_RWTCSRA    EQU     0xE6020004

        IMPORT  undef_entry
        IMPORT  svc_entry
        IMPORT  irq_entry
        IMPORT  iabort_entry
        IMPORT  dabort_entry
        IMPORT  fiq_entry
        IMPORT  _ddr_cortexa_mmu_init
        IMPORT  _kernel_invalid_tlb
        IMPORT  _kernel_invalid_cache
        IMPORT  mmu_cfgtbl
        IMPORT  ?main

        SECTION CSTACK:DATA:NOROOT(3)
        SECTION SVC_STACK:DATA:NOROOT(3)
        SECTION IRQ_STACK:DATA:NOROOT(3)
        SECTION FIQ_STACK:DATA:NOROOT(3)
        SECTION ABT_STACK:DATA:NOROOT(3)
        SECTION UND_STACK:DATA:NOROOT(3)
        SECTION TLB_RAMSEC:DATA:ROOT(14)

        SECTION .intvec:CODE:ROOT(5)
        CODE32

        PUBLIC  mtk_vector_table
mtk_vector_table:
        B       Reset_Handler
        LDR     PC, UndefVector
        LDR     PC, SvcVector
        LDR     PC, IAbortVector
        LDR     PC, DAbortVector
        NOP
        LDR     PC, IrqVector
        LDR     PC, FiqVector

UndefVector:    DCD     undef_entry
SvcVector:      DCD     svc_entry
IAbortVector:   DCD     iabort_entry
DAbortVector:   DCD     dabort_entry
IrqVector:      DCD     irq_entry
FiqVector:      DCD     fiq_entry

        SECTION .text:CODE:NOROOT(2)
        CODE32

        PUBLIC  Reset_Handler
Reset_Handler:
        CPSID   IF, #SYS_MODE
        LDR     SP, =SFE(CSTACK)

        MRC     p15, 0, r0, c0, c0, 5
        AND     r0, r0, #0x0F
        CMP     r0, #0
        BNE     secondary_cpu_park

        LDR     r0, =RWDT_RWTCSRA
        LDR     r1, =0xA5A5A500
        STR     r1, [r0]

        MRC     p15, 0, r0, c1, c0, 0
        BIC     r0, r0, #(1 << 12)
        BIC     r0, r0, #(1 << 2)
        BIC     r0, r0, #(1 << 1)
        BIC     r0, r0, #(1 << 0)
        BIC     r0, r0, #(1 << 13)
        DSB
        MCR     p15, 0, r0, c1, c0, 0
        ISB

        BL      _kernel_invalid_cache
        MOV     r0, #0
        MCR     p15, 0, r0, c7, c5, 6
        BL      _kernel_invalid_tlb

        LDR     r0, =mtk_vector_table
        MCR     p15, 0, r0, c12, c0, 0
        ISB

        MRC     p15, 0, r0, c1, c0, 1
        ORR     r0, r0, #(1 << 6)
        MCR     p15, 0, r0, c1, c0, 1
        ISB

        LDR     r0, =SFB(TLB_RAMSEC)
        LDR     r1, =mmu_cfgtbl
        BL      _ddr_cortexa_mmu_init

        LDR     lr, =mmu_enabled
        BX      lr
mmu_enabled:
        CPS     #FIQ_MODE
        LDR     sp, =SFE(FIQ_STACK)
        CPS     #UND_MODE
        LDR     sp, =SFE(UND_STACK)
        CPS     #ABT_MODE
        LDR     sp, =SFE(ABT_STACK)
        CPS     #SVC_MODE
        LDR     sp, =SFE(SVC_STACK)
        CPS     #IRQ_MODE
        LDR     sp, =SFE(IRQ_STACK)
        CPS     #SYS_MODE
        LDR     sp, =SFE(CSTACK)
        LDR     lr, =?main
        BX      lr

secondary_cpu_park:
        WFE
        B       secondary_cpu_park

        END
